# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string — local, or Atlas (SRV form):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lms?retryWrites=true&w=majority
# If your network's DNS rejects SRV lookups (error: querySrv ECONNREFUSED), use the
# standard form from Atlas → Connect → Drivers → toggle "SRV Connection String" off.
MONGODB_URI=mongodb://127.0.0.1:27017/lms

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3000

# Salary slip uploads. Files go from the browser straight to Cloudinary using a
# signature issued by this API, then the API verifies the asset via the Admin API.
# Get these from Cloudinary Dashboard → API Keys. In Settings → Security, allow
# delivery of PDF files (restricted by default on new accounts).
MAX_FILE_SIZE_MB=5
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Seeded executive accounts (used by `npm run seed`)
SEED_PASSWORD=Password@123
